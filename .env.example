NODE_ENV=development
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartbot

TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

ETHEREUM_RPC_URL=
BASE_RPC_URL=
BSC_RPC_URL=
 
MONITOR_WATCHLIST_PATH=data/monitor-wallets.json
MONITOR_KNOWN_TOKENS_PATH=data/monitor-known-tokens.json
MONITOR_OUTPUT_DIR=output/monitor-worker
MONITOR_CHAINS=ethereum,base
MONITOR_ACTIVITY_PROVIDER=rpc-known-tokens
MONITOR_EXPLORER_PROVIDER=blockscout

MONITOR_MAX_WALLETS=20
MONITOR_ETHEREUM_BLOCKS=3000
MONITOR_BASE_BLOCKS=10000
MONITOR_BSC_BLOCKS=10000

MONITOR_TX_CONTEXT=true
MONITOR_MAX_TX_CONTEXT_LOOKUPS=50
MONITOR_INTERVAL_SECONDS=300

MONITOR_SIGNAL_MIN_CATEGORY=watch_signal
MONITOR_SEND_WEAK=false
MONITOR_SEND_IGNORED=false
MONITOR_DRY_RUN=false

DISCOVERY_WORKER_ENABLED=true
DISCOVERY_INTERVAL_SECONDS=21600
DISCOVERY_DRY_RUN=true
DISCOVERY_AUTO_ADD=false
DISCOVERY_AUTO_ADD_MIN_SCORE=70
DISCOVERY_MAX_NEW_WALLETS_PER_RUN=20
ALPHA_WALLET_REVIEW_PATH=data/alpha-wallet-review.local.json

BASE_BLOCKSCOUT_API_URL=https://base.blockscout.com/api
ETHEREUM_BLOCKSCOUT_API_URL=
BSC_BLOCKSCOUT_API_URL=
ETHERSCAN_API_KEY=

DEXSCREENER_BASE_URL=https://api.dexscreener.com

EVM_SCAN_CHUNK_SIZE=1200
EVM_SCAN_MAX_BLOCKS=80000
EVM_SCAN_MAX_LOGS=10000
EVM_SCAN_MAX_TRADES=2000